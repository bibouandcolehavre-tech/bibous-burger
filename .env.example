# À remplir uniquement sur le serveur de production. Ne jamais mettre ces valeurs dans l’application mobile.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_RETURN_URL=https://votre-domaine.fr/paiement-termine
SUMUP_REDIRECT_URL=https://votre-domaine.fr/commande-confirmee

# Connexion client par SMS via Twilio Verify. À configurer uniquement côté serveur.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Clé privée utilisée pour garder les clients connectés après un redémarrage du serveur.
# Utiliser une valeur aléatoire longue et ne jamais la partager ni la mettre dans Git.
SESSION_SECRET=

# Accès à l’espace restaurant. À choisir et à renseigner dans Render.
RESTAURANT_DASHBOARD_PASSWORD=

# Notifications natives : laisser désactivées avant la connexion des signatures et le test sur téléphone.
# Voir PUSH_NOTIFICATIONS.md. Aucune clé Apple/Google ne doit être ajoutée au dépôt.
PUSH_ENABLED=false
PUSH_IOS_ENABLED=false
PUSH_ANDROID_ENABLED=false
# Facultatif : jeton serveur Expo pour la sécurité renforcée du service Push.
EXPO_ACCESS_TOKEN=

# SMS après appel Keyyo : secrets serveur uniquement, aucun changement de routage.
# Voir KEYYO_CALL_SMS.md. Ne pas autoriser toutes les IP de l'hébergeur chez Keyyo.
KEYYO_CALL_SMS_ENABLED=false
KEYYO_LINE=
KEYYO_WEBHOOK_SECRET=
KEYYO_SMS_PRIVACY_KEY=
KEYYO_SIP_PASSWORD=
