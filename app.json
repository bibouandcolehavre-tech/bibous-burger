{
  "expo": {
    "name": "Bibou's Burgers",
    "slug": "bibous-burger",
    "owner": "bibou-and-co",
    "extra": {
      "eas": {
        "projectId": "2c35adf5-23b6-474e-a790-c8cf39d4d70a"
      }
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "bibousburgers",
    "icon": "./assets/android-icon-gradient.png",
    "backgroundColor": "#FBF3E6",
    "primaryColor": "#315B4B",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bibouandco.bibousburgers",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.krokly.bibousburgers",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "icon": "./assets/android-icon-gradient.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-adaptive-foreground-gradient.png",
        "backgroundImage": "./assets/android-adaptive-background-gradient.png",
        "backgroundColor": "#315B4B"
      }
    },
    "web": {
      "favicon": "./assets/android-icon-gradient.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#315B4B",
          "image": "./assets/bibous-official-wordmark-preview.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#315B4B",
            "image": "./assets/bibous-official-wordmark-preview.png",
            "imageWidth": 220
          }
        }
      ],
      "expo-secure-store",
      ["expo-notifications", { "color": "#315B4B", "defaultChannel": "commandes" }]
    ]
  }
}
